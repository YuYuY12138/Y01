# 源码按文本管理；UE 资产和视觉资源通过 Git LFS 管理
* text=auto
*.bat text eol=crlf
*.cmd text eol=crlf
*.sh text eol=lf

# 交付包及授权证据保持原始字节，避免换行转换破坏其哈希记录
ArtSource/** -text
UI_Deliverables/** -text

*.uasset filter=lfs diff=lfs merge=lfs -text
